# Required: Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum wall-clock seconds for a single agent run (step 3)
# MAX_RUN_SECONDS=150

# Allow execution of user-supplied workspace code (step 4).
# Keep false on public deployments.
# ALLOW_CODE_EXECUTION=false

# Allow pip/npm install inside the sandbox (step 4)
# ALLOW_PACKAGE_INSTALL=false

# Comma-separated list of allowed CORS origins (step 5)
# CORS_ORIGINS=http://localhost:5173

# Optional access token for /api/run-agent and /api/test-sandbox (step 5)
# APEX_ACCESS_TOKEN=

# Per-IP rate limit on protected endpoints (requests per minute, step 5)
# RATE_LIMIT_RPM=5
