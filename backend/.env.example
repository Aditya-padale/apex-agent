# Required: Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Maximum wall-clock seconds for a single agent run
# Keep this at 50 or lower on Vercel (the deployed function is capped at 60s).
# MAX_RUN_SECONDS=50

# Allow execution of user-supplied workspace code.
# Keep false on public deployments.
# ALLOW_CODE_EXECUTION=false

# Allow pip/npm install inside the sandbox
# ALLOW_PACKAGE_INSTALL=false

# Comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:5173

# Optional access token for /api/run-agent and /api/test-sandbox
# APEX_ACCESS_TOKEN=

# Per-IP rate limit on protected endpoints (requests per minute)
# RATE_LIMIT_RPM=5
